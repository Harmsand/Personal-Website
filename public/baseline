<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Baseline — Preventive Health Dashboard (Concept Prototype)</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --forest: #1B4D3E;
  --forest-mid: #2D7A5F;
  --fern: #3A9B74;
  --sage: #6BAE8A;
  --sage-light: #C8E6D5;
  --mint: #EAF5EE;
  --gold: #C8923A;
  --gold-light: #F5E8D5;
  --ink: #1A1F2E;
  --mid: #4A5E5C;
  --muted: #7A8F8C;
  --soft: #A8BFBA;
  --border: #DCE9E5;
  --bg: #F4F1EC;
  --surface: #FFFFFF;
  --surface2: #F0EDE8;
  --red: #C0392B;
  --amber: #D08A00;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--ink);
  min-height: 100vh;
  font-size: 13px;
}

/* ── LAYOUT ── */
.app { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }

/* ── SIDEBAR ── */
.sidebar {
  background: var(--forest);
  padding: 0;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}

.sidebar-logo {
  padding: 24px 20px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.sidebar-logo .brand {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  font-weight: 300;
  color: #fff;
  line-height: 1;
  margin-bottom: 2px;
}
.sidebar-logo .brand-sub {
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--sage);
}

.sidebar-patient {
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  gap: 10px;
}
.patient-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--fern);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  flex-shrink: 0;
}
.patient-name { font-size: 13px; font-weight: 500; color: #fff; line-height: 1.2; }
.patient-id { font-size: 10px; color: rgba(255,255,255,0.4); margin-top: 2px; }

.nav-section { padding: 16px 0 8px; }
.nav-label {
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  padding: 0 20px;
  margin-bottom: 4px;
}
.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 20px;
  cursor: pointer;
  transition: background 0.15s;
  border-left: 3px solid transparent;
}
.nav-item:hover { background: rgba(255,255,255,0.06); }
.nav-item.active {
  background: rgba(107,174,138,0.15);
  border-left-color: var(--sage);
}
.nav-icon {
  width: 16px;
  height: 16px;
  opacity: 0.6;
  flex-shrink: 0;
}
.nav-item.active .nav-icon { opacity: 1; }
.nav-text {
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.6);
}
.nav-item.active .nav-text { color: #fff; }
.nav-badge {
  margin-left: auto;
  font-size: 10px;
  font-weight: 600;
  padding: 1px 6px;
  border-radius: 10px;
  background: var(--sage);
  color: var(--forest);
}

.sidebar-bottom {
  margin-top: auto;
  padding: 16px 20px;
  border-top: 1px solid rgba(255,255,255,0.08);
}
.sidebar-bottom-text { font-size: 11px; color: rgba(255,255,255,0.35); line-height: 1.5; }
.sidebar-bottom-text strong { color: rgba(255,255,255,0.6); font-weight: 500; }

/* ── MAIN ── */
.main { overflow-y: auto; }

.topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 14px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 10;
}
.topbar-title { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 300; color: var(--forest); }
.topbar-title em { font-style: italic; color: var(--fern); }
.topbar-actions { display: flex; align-items: center; gap: 10px; }
.btn-primary {
  background: var(--forest);
  color: #fff;
  border: none;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
}
.btn-secondary {
  background: none;
  border: 1px solid var(--border);
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  color: var(--mid);
  font-family: 'DM Sans', sans-serif;
}
.last-updated { font-size: 11px; color: var(--muted); }

.content { padding: 24px 28px 48px; }

/* ── HEALTH SCORE HERO ── */
.hero-row {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 16px;
  margin-bottom: 20px;
}

.score-card {
  background: var(--forest);
  border-radius: 16px;
  padding: 24px;
  position: relative;
  overflow: hidden;
}
.score-card::before {
  content: '';
  position: absolute;
  top: -40px; right: -40px;
  width: 160px; height: 160px;
  border-radius: 50%;
  background: rgba(107,174,138,0.15);
}
.score-label { font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sage); margin-bottom: 8px; }
.score-number { font-family: 'Fraunces', serif; font-size: 72px; font-weight: 300; color: #fff; line-height: 1; margin-bottom: 4px; }
.score-max { font-size: 18px; color: rgba(255,255,255,0.35); }
.score-desc { font-size: 12px; color: rgba(255,255,255,0.6); line-height: 1.6; margin-bottom: 16px; }
.score-trend {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--sage);
  font-weight: 500;
}
.trend-up { color: var(--sage); }
.trend-down { color: #F08080; }

.alerts-card {
  background: var(--surface);
  border-radius: 16px;
  border: 1px solid var(--border);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.alerts-header {
  font-family: 'Fraunces', serif;
  font-size: 15px;
  font-weight: 400;
  color: var(--forest);
  margin-bottom: 14px;
}
.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}
.alert-item:last-child { border-bottom: none; padding-bottom: 0; }
.alert-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
}
.alert-dot.red { background: var(--red); }
.alert-dot.amber { background: var(--amber); }
.alert-dot.green { background: var(--fern); }
.alert-body {}
.alert-title { font-size: 13px; font-weight: 500; color: var(--ink); margin-bottom: 2px; }
.alert-detail { font-size: 11px; color: var(--muted); line-height: 1.5; }
.alert-action {
  margin-left: auto;
  font-size: 11px;
  font-weight: 600;
  color: var(--forest-mid);
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  padding-left: 8px;
}

/* ── SECTION LABELS ── */
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  margin-top: 24px;
}
.section-title {
  font-family: 'Fraunces', serif;
  font-size: 16px;
  font-weight: 400;
  color: var(--forest);
}
.section-link { font-size: 12px; color: var(--forest-mid); font-weight: 500; cursor: pointer; }

/* ── BIOMARKER GRID ── */
.marker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 4px;
}

.marker-card {
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 14px 16px;
  transition: box-shadow 0.15s;
}
.marker-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
.marker-card.flag-red { border-color: #F5C6C6; background: #FEF8F8; }
.marker-card.flag-amber { border-color: #F5DCB0; background: #FEFAF3; }
.marker-card.flag-green { border-color: var(--sage-light); }

.marker-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}
.marker-name { font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
.marker-status {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 4px;
}
.marker-status.optimal { background: var(--mint); color: var(--forest-mid); }
.marker-status.watch { background: #FEF3DC; color: #8A5800; }
.marker-status.high { background: #FEF0F0; color: var(--red); }

.marker-value {
  font-family: 'Fraunces', serif;
  font-size: 26px;
  font-weight: 400;
  line-height: 1;
  margin-bottom: 2px;
}
.marker-value.red { color: var(--red); }
.marker-value.amber { color: var(--amber); }
.marker-value.green { color: var(--forest-mid); }

.marker-unit { font-size: 11px; color: var(--muted); margin-bottom: 10px; }
.marker-range { font-size: 10px; color: var(--soft); margin-bottom: 8px; }

/* Mini sparkline */
.sparkline { display: flex; align-items: flex-end; gap: 2px; height: 24px; }
.spark-bar {
  flex: 1;
  border-radius: 2px 2px 0 0;
  min-height: 3px;
}
.spark-bar.green { background: var(--sage-light); }
.spark-bar.amber { background: #F5DCB0; }
.spark-bar.red { background: #F5C6C6; }
.spark-bar.active-green { background: var(--fern); }
.spark-bar.active-amber { background: var(--amber); }
.spark-bar.active-red { background: var(--red); }

/* ── BODY COMPOSITION ── */
.body-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.body-card {
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 16px;
}
.body-label { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
.body-value { font-family: 'Fraunces', serif; font-size: 32px; font-weight: 300; color: var(--ink); line-height: 1; margin-bottom: 2px; }
.body-unit { font-size: 12px; color: var(--muted); margin-bottom: 8px; }
.body-bar-bg { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; margin-bottom: 6px; }
.body-bar-fill { height: 100%; border-radius: 3px; }
.body-context { font-size: 11px; color: var(--muted); line-height: 1.5; }

/* ── TWO COLUMN ROW ── */
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 4px; }
.three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

/* ── CONDITIONS / HISTORY ── */
.list-card {
  background: var(--surface);
  border-radius: 14px;
  border: 1px solid var(--border);
  overflow: hidden;
}
.list-card-header {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.list-card-title { font-family: 'Fraunces', serif; font-size: 15px; font-weight: 400; color: var(--forest); }
.list-card-action { font-size: 11px; color: var(--forest-mid); font-weight: 500; cursor: pointer; }
.list-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 18px;
  border-bottom: 1px solid var(--border);
}
.list-row:last-child { border-bottom: none; }
.list-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}
.list-icon.green { background: var(--mint); }
.list-icon.amber { background: #FEF3DC; }
.list-icon.slate { background: var(--surface2); }
.list-main { flex: 1; }
.list-title { font-size: 13px; font-weight: 500; color: var(--ink); margin-bottom: 2px; }
.list-sub { font-size: 11px; color: var(--muted); }
.list-right { text-align: right; }
.list-date { font-size: 11px; color: var(--muted); }
.list-tag {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.list-tag.managed { background: var(--mint); color: var(--forest-mid); }
.list-tag.watch { background: #FEF3DC; color: #8A5800; }
.list-tag.resolved { background: var(--surface2); color: var(--muted); }

/* ── APPOINTMENTS ── */
.appt-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 18px;
  border-bottom: 1px solid var(--border);
}
.appt-row:last-child { border-bottom: none; }
.appt-date-block {
  text-align: center;
  width: 42px;
  flex-shrink: 0;
}
.appt-day { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 300; color: var(--forest); line-height: 1; }
.appt-month { font-size: 9px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
.appt-divider { width: 1px; height: 36px; background: var(--border); flex-shrink: 0; }
.appt-main { flex: 1; }
.appt-title { font-size: 13px; font-weight: 500; color: var(--ink); margin-bottom: 2px; }
.appt-with { font-size: 11px; color: var(--muted); }
.appt-type {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
  background: var(--mint);
  color: var(--forest-mid);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.appt-type.past { background: var(--surface2); color: var(--muted); }

/* ── RISK PANEL ── */
.risk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.risk-card {
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 16px;
}
.risk-card.elevated { border-color: #F5DCB0; background: #FEFAF3; }
.risk-label { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
.risk-level {
  font-family: 'Fraunces', serif;
  font-size: 20px;
  font-weight: 400;
  margin-bottom: 4px;
}
.risk-level.low { color: var(--forest-mid); }
.risk-level.moderate { color: var(--amber); }
.risk-level.elevated { color: var(--red); }
.risk-detail { font-size: 11px; color: var(--muted); line-height: 1.6; margin-bottom: 10px; }
.risk-bar-bg { height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; }
.risk-bar-fill { height: 100%; border-radius: 3px; }

/* ── REFERRALS ── */
.ref-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px;
  border-bottom: 1px solid var(--border);
}
.ref-row:last-child { border-bottom: none; }
.ref-circle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--mint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: var(--forest);
  flex-shrink: 0;
}
.ref-main { flex: 1; }
.ref-title { font-size: 13px; font-weight: 500; color: var(--ink); margin-bottom: 2px; }
.ref-detail { font-size: 11px; color: var(--muted); }
.ref-status {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.ref-status.active { background: #FEF3DC; color: #8A5800; }
.ref-status.complete { background: var(--mint); color: var(--forest-mid); }

/* ── WEARABLE STRIP ── */
.wearable-strip {
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 14px 18px;
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 4px;
}
.wearable-item {
  flex: 1;
  text-align: center;
  padding: 0 16px;
  border-right: 1px solid var(--border);
}
.wearable-item:last-child { border-right: none; }
.wearable-icon { font-size: 18px; margin-bottom: 4px; }
.wearable-val { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 300; color: var(--forest); line-height: 1; margin-bottom: 2px; }
.wearable-label { font-size: 10px; color: var(--muted); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
.wearable-sub { font-size: 10px; color: var(--soft); margin-top: 2px; }

/* ── QUICK ACTIONS ── */
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 4px; }
.quick-card {
  background: var(--surface);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 16px 14px;
  cursor: pointer;
  transition: all 0.15s;
  text-align: center;
}
.quick-card:hover { border-color: var(--sage); box-shadow: 0 4px 14px rgba(27,77,62,0.08); }
.quick-card.primary { background: var(--forest); border-color: var(--forest); }
.quick-icon { font-size: 22px; margin-bottom: 8px; }
.quick-label { font-size: 12px; font-weight: 600; color: var(--ink); }
.quick-card.primary .quick-label { color: #fff; }
.quick-sub { font-size: 10px; color: var(--muted); margin-top: 2px; }
.quick-card.primary .quick-sub { color: rgba(255,255,255,0.6); }

/* ── CHART AREA ── */
.chart-card {
  background: var(--surface);
  border-radius: 14px;
  border: 1px solid var(--border);
  padding: 18px;
}
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.chart-title { font-family: 'Fraunces', serif; font-size: 15px; font-weight: 400; color: var(--forest); }
.chart-legend { display: flex; gap: 14px; }
.legend-item { display: flex; align-items: center; gap: 5px; font-size: 10px; color: var(--muted); font-weight: 500; }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; }
.chart-area { height: 120px; position: relative; display: flex; align-items: flex-end; gap: 0; padding: 0 4px; }
.chart-line-wrapper { position: absolute; inset: 0; padding: 0 4px; }

/* Simple bar chart for blood work trend */
.bar-group { flex: 1; display: flex; align-items: flex-end; gap: 3px; padding: 0 3px; }
.bar-item { flex: 1; border-radius: 3px 3px 0 0; transition: opacity 0.2s; }
.bar-item:hover { opacity: 0.8; }

.chart-labels { display: flex; margin-top: 6px; padding: 0 4px; }
.chart-label { flex: 1; text-align: center; font-size: 10px; color: var(--muted); }

/* Tabs */
.tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 16px; }
.tab-item {
  font-size: 12px;
  font-weight: 500;
  padding: 9px 16px;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  color: var(--muted);
  margin-bottom: -1px;
}
.tab-item.active { color: var(--forest); border-bottom-color: var(--forest); }

/* ── MOBILE HEADER & OVERLAY ── */
.mobile-header {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 52px;
  background: var(--forest);
  z-index: 300;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}
.mobile-brand { font-family: 'Fraunces', serif; font-size: 17px; color: #fff; font-weight: 300; }
.mobile-brand em { color: var(--sage); font-style: normal; }
.hamburger {
  width: 36px; height: 36px;
  display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px;
  cursor: pointer; border-radius: 8px; background: rgba(255,255,255,0.1); border: none;
}
.hamburger span { display: block; width: 18px; height: 2px; background: #fff; border-radius: 2px; transition: all 0.25s; }
.sidebar-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.45); z-index: 298;
}
.sidebar-overlay.visible { display: block; }

@media (max-width: 768px) {
  .mobile-header { display: flex; }
  body { padding-top: 52px; }
  .app { display: block; }
  .sidebar {
    position: fixed;
    top: 52px; left: 0; bottom: 0;
    width: 260px;
    transform: translateX(-100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 299;
    overflow-y: auto;
  }
  .sidebar.open { transform: translateX(0); }
