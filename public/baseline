    </div>
    <div class="content" id="view-care-team" style="display:none;">
      <div class="section-row" style="margin-bottom:20px;"><div class="section-title" style="font-size:18px;">My Care Team</div></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div style="background:var(--surface);border-radius:12px;padding:20px;"><div style="font-weight:600;margin-bottom:2px;">Dr. Demo Physician</div><div style="font-size:12px;color:var(--muted);">Family Physician · Demo Clinic</div><div style="margin-top:10px;"><button class="btn-secondary" style="font-size:11px;padding:5px 12px;">Send Message</button></div></div>
        <div style="background:var(--surface);border-radius:12px;padding:20px;"><div style="font-weight:600;margin-bottom:2px;">Dr. Demo Cardiologist</div><div style="font-size:12px;color:var(--muted);">Cardiologist · Demo Heart Clinic · Referral pending</div><div style="margin-top:10px;"><button class="btn-secondary" style="font-size:11px;padding:5px 12px;">Send Message</button></div></div>
      </div>
    </div>
    <div class="content" id="view-request-tests" style="display:none;">
      <div class="section-row" style="margin-bottom:20px;"><div class="section-title" style="font-size:18px;">Suggested Tests</div></div>
      <div style="background:var(--surface);border-radius:12px;padding:24px;max-width:480px;">
        <div style="font-size:13px;color:var(--muted);margin-bottom:16px;">Based on your results and risk trends, these tests are suggested. Choose the ones you want to discuss. Your physician decides what is ordered.</div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;"><input type="checkbox" checked> <span>ApoB</span></label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;"><input type="checkbox" checked> <span>HbA1c + fasting glucose</span></label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;"><input type="checkbox"> <span>Total testosterone + free testosterone</span></label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;"><input type="checkbox"> <span>Vitamin D</span></label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;"><input type="checkbox"> <span>hs-CRP</span></label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;"><input type="checkbox"> <span>CBC</span></label>
        </div>
        <button class="btn-primary" style="margin-top:20px;width:100%;">Send to my physician for review</button>
      </div>
    </div>

  </main>
</div>

<style>
.biomarker-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.biomarker-card { background:var(--surface); border-radius:12px; padding:16px; }
.bm-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.bm-name { font-weight:600; font-size:12px; color:var(--ink); }
.bm-status { font-size:10px; font-weight:600; padding:2px 8px; border-radius:10px; }
.bm-status.red { background:#fde8e8; color:#c0392b; }
.bm-status.amber { background:#fef3dc; color:#8a5800; }
.bm-status.green { background:var(--mint); color:var(--forest); }
.bm-value { font-family:'Fraunces',serif; font-size:24px; font-weight:300; color:var(--ink); }
.bm-unit { font-family:'DM Sans',sans-serif; font-size:12px; color:var(--muted); }
.bm-range { font-size:11px; color:var(--muted); margin-top:2px; }
.bm-trend { font-size:11px; color:var(--forest-mid); margin-top:4px; font-weight:500; }
.risk-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.risk-card { background:var(--surface); border-radius:12px; padding:16px; }
.risk-name { font-weight:600; font-size:13px; margin-bottom:6px; }
.risk-level { font-size:11px; font-weight:700; padding:2px 10px; border-radius:10px; display:inline-block; margin-bottom:8px; }
.risk-level.red { background:#fde8e8; color:#c0392b; }
.risk-level.amber { background:#fef3dc; color:#8a5800; }
.risk-level.green { background:var(--mint); color:var(--forest); }
.risk-detail { font-size:12px; color:var(--muted); line-height:1.5; }
</style>

<script>
const navMap = {
  'Dashboard': 'dashboard',
  'Health Score': 'health-score',
  'Biomarkers': 'biomarkers',
  'Body Composition': 'body-comp',
  'Risk Trends': 'risk',
  'Conditions': 'conditions',
  'Appointments': 'appointments',
  'Referrals': 'referrals',
  'My Care Team': 'care-team',
  'Suggested Tests': 'request-tests',
  'Messages': 'messages'
};

function showView(viewId) {
  document.querySelectorAll('.content').forEach(el => el.style.display = 'none');
  const target = document.getElementById('view-' + viewId) || document.querySelector('.content');
  if (target) target.style.display = 'block';
}

document.querySelectorAll('.nav-item').forEach(item => {
  item.style.cursor = 'pointer';
  item.addEventListener('click', function() {
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    this.classList.add('active');
    const label = this.querySelector('.nav-text').textContent.trim();
    const viewId = navMap[label] || 'dashboard';
    showView(viewId);
  });
});

// Dashboard content div already has id="view-dashboard"

function switchBioTab(tabId, el) {
  document.querySelectorAll('#view-biomarkers [id^="bio-"]').forEach(t => t.style.display = 'none');
  document.getElementById('bio-' + tabId).style.display = 'block';
  document.querySelectorAll('#bio-tabs .tab-item').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

// Mobile nav toggle
const hamburger = document.getElementById('hamburger');
const sidebar = document.querySelector('.sidebar');
const overlay = document.getElementById('overlay');

function openSidebar() {
  sidebar.classList.add('open');
  overlay.classList.add('visible');
  document.body.style.overflow = 'hidden';
}
function closeSidebar() {
  sidebar.classList.remove('open');
  overlay.classList.remove('visible');
  document.body.style.overflow = '';
}
if (hamburger) {
  hamburger.addEventListener('click', () => sidebar.classList.contains('open') ? closeSidebar() : openSidebar());
}
if (overlay) {
  overlay.addEventListener('click', closeSidebar);
}
// Close sidebar on nav item click (mobile)
document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', () => {
    if (window.innerWidth <= 768) closeSidebar();
  });
});

(function(){
  var steps = [
    ['Dashboard','<b>One screen, one answer.</b> The home view leads with a single health score and the two or three items that need attention, instead of a wall of lab values.'],
    ['Biomarkers','<b>Results in context.</b> Each marker shows where you sit against an optimal range, not just the lab reference range, and how it has moved over time.'],
    ['Risk Trends','<b>Trends over snapshots.</b> Risk is shown as direction of travel, which is what a patient can actually act on.'],
    ['Suggested Tests','<b>Recommend, don\'t order.</b> The dashboard suggests the next test from the patient\'s own results and sends it to the physician for review. The physician decides, so clinical judgement stays where it belongs.'],
    ['Appointments','<b>Connected to care.</b> Follow-ups, referrals and the care team sit beside the data they relate to.']
  ];
  var i = 0, box = document.getElementById('proto-tour');
  function go(label){
    var items = document.querySelectorAll('.nav-item');
    for (var k=0;k<items.length;k++){
      var t = items[k].querySelector('.nav-text');
      if (t && t.textContent.trim()===label){ items[k].click(); break; }
    }
  }
  function render(){
    go(steps[i][0]);
    document.getElementById('proto-tour-text').innerHTML = steps[i][1];
    document.getElementById('pt-count').textContent = (i+1)+' / '+steps.length;
    document.getElementById('pt-back').style.visibility = i===0?'hidden':'visible';
    document.getElementById('pt-next').textContent = i===steps.length-1?'Finish':'Next';
  }
  function start(){ i=0; box.style.display='block'; render(); }
  function stop(){ box.style.display='none'; go('Dashboard'); }
  document.getElementById('pt-next').onclick=function(){ if(i===steps.length-1){stop();} else {i++;render();} };
  document.getElementById('pt-back').onclick=function(){ if(i>0){i--;render();} };
  document.getElementById('pt-exit').onclick=stop;
  document.getElementById('proto-tour-btn').onclick=start;
  document.getElementById('pw-tour').onclick=function(){ document.getElementById('proto-welcome').style.display='none'; start(); };
  document.getElementById('pw-explore').onclick=function(){ document.getElementById('proto-welcome').style.display='none'; };
})();
</script>
</body>
</html>