---
import '@fontsource-variable/archivo';
import '@fontsource-variable/inter';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="top">
      <div class="container bar">
        <a class="name" href="/">{SITE.name}</a>
        <nav aria-label="Main">
          <a href="/#about">About</a>
          <a href="/#work">What I do</a>
          {SITE.showProjects && <a href="/#projects">Projects</a>}
          <a href="/#background">Background</a>
          {SITE.showWriting && <a href="/writing/">Writing</a>}
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="container">
        <p>© {new Date().getFullYear()} {SITE.name}. Vancouver, Canada.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #222222;
    --muted: #626262;
    --red: #cc0000;
    --red-hover: #a80000;
    --surface: #f4f4f4;
    --border: #d9d9d9;
    --font-head: 'Archivo Variable', 'Inter Variable', Arial, sans-serif;
    --font-body: 'Inter Variable', 'Helvetica Neue', Arial, sans-serif;
    /* aliases used by the Writing pages */
    --text: var(--ink);
    --line: var(--border);
    --accent: var(--red);
    --serif: var(--font-head);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 { font-family: var(--font-head); font-weight: 600; margin: 0; }

  a { color: var(--ink); text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  a:hover { color: var(--red-hover); }
  a:focus-visible, .btn:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

  .container { width: min(100% - 3rem, 72rem); margin-inline: auto; }
  .wrap { width: auto; margin: 0; }

  .top { border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1rem; }
  .name { font-family: var(--font-head); font-weight: 600; font-size: 1.25rem; text-decoration: none; }
  .top nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; font-size: 0.9375rem; }
  .top nav a { color: var(--muted); text-decoration: none; }
  .top nav a:hover { color: var(--ink); text-decoration: underline; }

  .btn {
    display: inline-block;
    background: var(--red);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 0;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }
  .btn:hover { background: var(--red-hover); color: #fff; }

  .foot { border-top: 1px solid var(--border); padding-block: 2rem; color: var(--muted); font-size: 0.875rem; }
  .foot p { margin: 0; }

  @media (max-width: 40rem) {
    .bar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
