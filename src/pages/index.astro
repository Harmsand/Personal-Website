---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import DocFlow from '../components/DocFlow.astro';

const areas = [
  {
    title: 'AI in regulated operations',
    body:
      'Putting AI into production where decisions have to stand up to audit. Intelligent document processing for medical and claims documents, human review designed into the workflow from the start, and the privacy and governance work that lets an insurer trust what the model is doing.',
  },
  {
    title: 'Provider and payer technology',
    body:
      'The systems between insurers and the healthcare providers who treat their clients: provider registry and onboarding, invoicing and payment, the rules that decide what is covered and payable, identity and access, and the integrations that connect it all. A growing part of the work is getting these systems ready for AI agents, so software can work directly with other software instead of waiting on people and paperwork.',
  },
  {
    title: 'Claims and case management',
    body:
      'Tools for the people who manage claims and cases: intake, triage, case workflow and decision support, built so staff spend their time on judgment rather than paperwork.',
  },
];

// Featured projects. Add one or two, then set showProjects: true in src/config.ts.
// Each: { title, what, did, result, href, linkText }. Use only real details.
const projects: {
  title: string;
  what: string;
  did: string;
  result: string;
  href?: string;
  linkText?: string;
}[] = [
  {
    title: 'Document intelligence for a workers\' compensation insurer',
    what:
      'Much of what reaches an insurer still arrives by fax. This product takes incoming documents, whether faxes, scans, images or files, groups and sorts them, identifies each document type, reads the key fields, and formats the results so they go straight into the claims system.',
    did:
      'I own the product as part of the portfolio I lead, covering document classification, OCR, the uploader and the format transformer.',
    result:
      'It is on track to turn nearly a million faxes a year into fielded information staff can act on, with less manual handling and lower cost.',
  },
];

const showProjects = SITE.showProjects && projects.length > 0;

// Section numbers follow whichever sections are shown.
const order = ['about', 'work', ...(showProjects ? ['projects'] : []), 'background'];
const num = (k: string) => String(order.indexOf(k) + 1).padStart(2, '0');

const hasProfiles = SITE.linkedin || SITE.github;
// Main contact button: email if one is set, otherwise LinkedIn (keeps the email address off the page).
const primary = SITE.email
  ? { href: `mailto:${SITE.email}`, text: 'Email me' }
  : SITE.linkedin
    ? { href: SITE.linkedin, text: 'Message me on LinkedIn' }
    : null;
const linkedinIsButton = !SITE.email && !!SITE.linkedin;
---

<Base>
  <section class="hero container">
    <div class="intro">
    <h1>{SITE.name}</h1>
    <p class="line">
      I'm a product leader who uses AI to modernize how insurers handle claims and pay healthcare providers.
    </p>
    <p class="who">I came to insurance technology after years in retail operations at Apple, and I hold an MBA from UBC Sauder.</p>
    {
      hasProfiles && (
        <ul class="profiles">
          {SITE.github && (
            <li>
              <a href={SITE.github} rel="me">GitHub</a>
            </li>
          )}
          {SITE.linkedin && (
            <li>
              <a href={SITE.linkedin} rel="me">LinkedIn</a>
            </li>
          )}
        </ul>
      )
    }
      </div>
    <DocFlow />
  </section>

  <section id="about" class="sec">
    <div class="container grid">
      <h2><span class="n">{num('about')}</span>About</h2>
      <div class="body">
        <p class="prose">
          I take messy operational problems in claims and provider billing and turn them into software people
          use. I know the insurance side well: how claims move, how providers get paid, and what regulators and
          auditors expect to see.
        </p>
        <p class="prose">
          I'm interested in how AI changes that work, including getting systems ready for AI agents and
          software-to-software exchange. I build with AI myself, so I judge what works from using it.
        </p>
      </div>
    </div>
  </section>

  <section id="work" class="sec tint">
    <div class="container grid">
      <h2><span class="n">{num('work')}</span>What I do</h2>
      <div class="body">
        <div class="rows">
          {
            areas.map((a) => (
              <div class="row">
                <h3>{a.title}</h3>
                <p>{a.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    showProjects && (
      <section id="projects" class="sec">
        <div class="container grid">
          <h2><span class="n">{num('projects')}</span>Featured projects</h2>
          <div class="body">
            {projects.map((p) => (
              <article class="project">
                <h3>{p.title}</h3>
                <p>{p.what}</p>
                <p>{p.did}</p>
                <p>{p.result}</p>
                {p.href && <a href={p.href}>{p.linkText ?? 'See the project'}</a>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="background" class="sec">
    <div class="container grid">
      <h2><span class="n">{num('background')}</span>Background</h2>
      <div class="body rows">
        <div class="row">
          <h3>Now</h3>
          <p>Senior Manager, Product Management at WorkSafeBC, British Columbia's workers' compensation board. I lead a team of five product managers.</p>
        </div>
        <div class="row">
          <h3>Before</h3>
          <ul class="plain">
            <li>Co-founder, Velour, a media company</li>
            <li>Sales Manager, then Inventory Supervisor, Apple, 2010 to 2016. Inventory lead for the largest Apple store in Western Canada.</li>
          </ul>
        </div>
        <div class="row">
          <h3>Education</h3>
          <p>MBA, UBC Sauder School of Business</p>
        </div>
        <div class="row">
          <h3>Areas I know</h3>
          <p>Provider portals, payer-provider integration, identity and access, AI document intelligence, claims management.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="sec tint">
    <div class="container grid">
      <h2>Contact</h2>
      <div class="body">
        <p class="open">Happy to talk about AI in insurance and healthcare.</p>
        {primary && <a class="btn" href={primary.href}>{primary.text}</a>}
        {
          SITE.github && (
            <p class="gh">
              Some of what I build is on <a href={SITE.github} rel="me">GitHub</a>.
            </p>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 6rem 4rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 4rem; align-items: center; }
  @media (max-width: 60rem) { .hero { grid-template-columns: 1fr; gap: 3rem; } }

  .hero h1 {
    font-size: clamp(2.75rem, 6.5vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .hero .line {
    font-size: 1.25rem;
    line-height: 1.45;
    max-width: 34rem;
    margin: 1.5rem 0 0;
  }

  .hero .who { margin: 0.75rem 0 0; max-width: 34rem; color: var(--muted); }

  .profiles { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; gap: 1.5rem; }
  .gh { margin: 1.5rem 0 0; }

  .sec { padding-block: 4rem; }
  .sec.tint { background: var(--surface); }

  .grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    column-gap: 3rem;
  }

  .grid h2 { font-size: 1.75rem; line-height: 1.15; }
  .n { color: var(--red); font-size: 1rem; margin-right: 0.75rem; font-variant-numeric: tabular-nums; }

  .prose { max-width: 40rem; margin: 0 0 1rem; font-size: 1.125rem; line-height: 1.6; }
  .prose:last-child { margin-bottom: 0; }

  .flow { margin: 0 0 3rem; }
  .flow ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: 1rem;
  }
  .flow li { border-top: 2px solid var(--ink); padding-top: 0.75rem; font-size: 0.9375rem; line-height: 1.4; }
  .flow li:last-child { border-top-color: var(--red); }
  .flow strong { display: block; font-family: var(--font-head); font-weight: 600; font-size: 1.0625rem; }
  .flow span { display: block; margin-top: 0.25rem; color: var(--muted); }

  .rows .row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    column-gap: 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .rows .row:first-child { padding-top: 0; border-top: 0; }
  .row h3 { font-size: 1.125rem; line-height: 1.3; }
  .row p { margin: 0; max-width: 38rem; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; max-width: 38rem; }

  .project { max-width: 40rem; padding-bottom: 2rem; }
  .project h3 { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .project p { margin: 0 0 0.75rem; }

  .open { font-family: var(--font-head); font-weight: 500; font-size: 1.5rem; line-height: 1.35; max-width: 28rem; margin: 0 0 1.5rem; }

  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr; row-gap: 1.5rem; }
    .hero { padding-block: 4rem 3rem; }
  }

  @media (max-width: 40rem) {
    .flow ol { grid-template-columns: 1fr; row-gap: 1rem; }
    .rows .row { grid-template-columns: 1fr; row-gap: 0.5rem; }
    .sec { padding-block: 3rem; }
  }
</style>
